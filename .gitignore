# Project-specific
# Clarius SDK binaries + TLS material (live copies in src/capture/; not committed).
# pysidecaster.py and pyimu.py load them from src/capture/ via _LIB_DIR, not from the root.
libcast.dylib
pyclariuscast.so
pri.pem
tls.crt

# Large / regenerable data (kept locally, not committed)
data/
# paper figures tracked; other media (ply/npz) stay ignored
media/*
!media/*.png
runs/
yolo_ds/
*.ply
*.npz
# handoff/ is a curated pull-point — track its point cloud
!handoff/*.ply
sim_handoff.zip

# Audit: frames are regenerable, TRUTH IS NOT — carve it out
audit/*
!audit/audit_truth.json
!audit/audit_manifest.json
!audit/exemplars.json

# Pose/exec logs are data, but teach files are work products — keep them.
# (Launch files shifted_*.jsonl live in the ultrasound-cobot repo, not here.)
pose_logs/exec_*
!pose_logs/sweep_teach_*.jsonl

# Note: calib/ (hand-eye, bridge, intrinsics, urdf), exemplars.json, handoff/, outputs/
# are intentionally tracked. data/pose_logs/README.md is force-tracked (git add -f);
# the rest of data/ stays ignored.
# --- additions Aug 31: gold-label sprint + gauge/E5 era ---
overlays/
# attic/ holds superseded scripts (tracked, with a one-line note each) and old bundles
attic/*
!attic/*.py
!attic/README.md
models/*
!models/README.md
*.pt
*.mp4
*.avi
outputs/videos/

# gold datasets: images regenerate from sections; HUMAN LABELS DO NOT — carve them out
yolo_ds_gold/
yolo_ds_human/*
!yolo_ds_human/labels
!yolo_ds_human/labels/**

